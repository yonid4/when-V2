# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Calendar OAuth
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar-accounts/callback

# Microsoft (Outlook) Calendar OAuth — optional; leave blank to disable.
# Register an app in the Microsoft Entra admin center with audience
# "Accounts in any organizational directory and personal Microsoft accounts",
# add a Web redirect URI matching MICROSOFT_CALENDAR_REDIRECT_URI, and create a
# client secret. Delegated permission Calendars.ReadWrite (user-consentable).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar-accounts/callback/microsoft

# Gemini (agentic chat) — optional; leave GEMINI_API_KEY blank to disable chat.
# Create an API key in Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
